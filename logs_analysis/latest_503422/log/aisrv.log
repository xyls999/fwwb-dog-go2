[env_conf]
  task_name = Unitree-Go2-Velocity
  device = cuda:0
  use_fabric = True
  save_mp4 = True
  seed = 0
[terrain]
  curriculum = False
  track = {'num_parallel_tracks': 10, 'track_length': 1, 'sub_terrains': ['open_entry_maze']}
  mode = track
  level = [0, 1, 2, 3]
  difficulty_range = [0.0, 1.0]
  standard = {'sub_terrains': ['pyramid_slope', 'pyramid_slope_inv', 'pyramid_stairs', 'pyramid_stairs_inv']}
[policy]
  nav_decimation = 1
[env]
  num_envs = 16
  episode_length_s = 80.0
[custom_parameters]
  episode_nums_per_terrain = 1
  enable_terrain_bounds_termination = True
[domain_rand]
  enable_domain_rand = False
  randomize_friction = False
  friction_range = [0.3, 1.5]
  push_robots = False
  push_interval_s = 15
  max_push_vel_xy = 0.5
[noise]
  add_noise = False
[init_state]
  pos = [0.0, 0.0, 0.35]
[commands]
  resampling_time = [300.0, 300.0]
  limit = {'lin_vel_x': [0.0, 0.65], 'lin_vel_y': [0.0, 0.0], 'ang_vel_z': [-1.5, 1.5]}
  ranges = {'lin_vel_x': [0.25, 0.5], 'lin_vel_y': [0.0, 0.0], 'ang_vel_yaw': [-1.2, 1.2]}
